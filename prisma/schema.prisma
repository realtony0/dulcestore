generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  tagline       String
  position      Int           @default(0)
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(cuid())
  slug       String
  name       String
  position   Int       @default(0)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, slug])
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  tagline       String
  description   String
  /** Prix de la variante la plus basse, affiché "à partir de" quand il y a des variantes. */
  priceFCFA     Int
  weightKg      Float
  /** Minimum de commande (packaging vendu par lot). 1 = pas de minimum. */
  minOrderQty   Int              @default(1)
  /** Coloris disponibles, séparés par des virgules. Purement informatif. */
  colors        String?
  /** Photo produit propre (sans texte), utilisée en priorité dans les cartes et la fiche. */
  imageUrl      String
  afficheUrl    String
  position      Int              @default(0)
  inStock       Boolean          @default(true)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  variants      ProductVariant[]
  specs         ProductSpec[]
  orderItems    OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  /** "photo" = visuel produit, "fiche" = fiche technique fournisseur. */
  kind      String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String      @id @default(cuid())
  name       String
  priceFCFA  Int
  weightKg   Float
  position   Int         @default(0)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model ProductSpec {
  id        String  @id @default(cuid())
  label     String
  value     String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  createdAt        DateTime    @default(now())
  status           String      @default("EN_ATTENTE_PAIEMENT")
  customerName     String
  customerPhone    String
  customerEmail    String?
  destination      String
  customerCity     String
  customerAddress  String?
  shippingMethod   String
  /** Fixé par Dulce Store après pesée du colis, puis communiqué au client. */
  shippingFeeFCFA  Int?
  productTotalFCFA Int
  totalWeightKg    Float
  paymentMethod    String
  paymentStatus    String      @default("EN_ATTENTE")
  providerRef      String?
  items            OrderItem[]
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  label         String
  quantity      Int
  unitPriceFCFA Int
}
