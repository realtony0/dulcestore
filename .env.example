DATABASE_URL="file:./dev.db"

# PayDunya (paydunya.com) — prestataire principal. Agrège Wave, Orange Money
# et carte bancaire derrière une seule API ("Checkout Invoice").
# Clés à récupérer sur le dashboard PayDunya > API d'intégration > votre
# application. Tant qu'elles sont vides, on bascule sur PayTech, puis sur le
# mode simulation (aucun débit réel) si PayTech n'est pas configuré non plus.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" (défaut) n'encaisse rien réellement. Passer à "live" une fois le
# compte validé (KYC) ET les clés de test remplacées par celles de production.
PAYDUNYA_MODE=test

# Force un prestataire : "paydunya" ou "paytech". Laisser vide pour le choix
# automatique (PayDunya si ses clés sont renseignées, PayTech sinon).
PAYMENT_PROVIDER=

# PayTech (paytech.sn) — prestataire de secours, même rôle que PayDunya.
# Clés à récupérer sur le dashboard PayTech > Réglages > API.
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# "test" (défaut) débite un montant factice de 100 à 150 FCFA. Passer à "prod"
# seulement une fois le compte PayTech activé (email contact@paytech.sn).
PAYTECH_ENV=test

# URL publique du site. Le prestataire de paiement y envoie ses notifications (IPN),
# elle doit donc être en HTTPS et joignable depuis l'extérieur.
#   production : https://dulce-store.com
#   en local   : l'URL d'un tunnel HTTPS (localtunnel, ngrok) — voir README.
# Si la variable est absente, le site retombe sur https://dulce-store.com.
NEXT_PUBLIC_SITE_URL="https://dulce-store.com"

# Mot de passe d'accès à /admin (liste des commandes). À définir avant la mise en ligne.
ADMIN_PASSWORD=

# Cloudflare R2 — stockage des photos ajoutées depuis le back-office.
# Le disque de Vercel étant effacé à chaque déploiement, les images doivent
# vivre ailleurs. Tant que ces 5 variables sont vides, le back-office reste
# utilisable : on colle l'URL d'une image déjà en ligne.
#
# Où trouver chaque valeur (dashboard Cloudflare) :
#   R2_ACCOUNT_ID        R2 > Overview, "Account ID" en haut à droite
#   R2_BUCKET            le nom que tu donnes au bucket (ex. dulce-store)
#   R2_ACCESS_KEY_ID     R2 > Manage API tokens > Create token (Object Read & Write)
#   R2_SECRET_ACCESS_KEY affichée une seule fois à la création du token
#   R2_PUBLIC_URL        Bucket > Settings > Public access (r2.dev ou domaine perso)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
