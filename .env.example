DATABASE_URL="file:./dev.db"

# PayTech (paytech.sn) — agrège Wave, Orange Money et carte bancaire derrière
# une seule API. Clés à récupérer sur le dashboard PayTech > Réglages > API.
# Tant qu'elles sont vides, le site tourne en mode simulation (aucun débit réel).
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# "test" (défaut) débite un montant factice de 100 à 150 FCFA. Passer à "prod"
# seulement une fois le compte PayTech activé (email contact@paytech.sn).
PAYTECH_ENV=test

# PayPal (non couvert par PayTech) — Orders API v2.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# URL publique du site. PayTech y envoie les notifications de paiement (IPN),
# elle doit donc être en HTTPS et joignable depuis l'extérieur.
#   production : https://dulce-store.com
#   en local   : l'URL d'un tunnel HTTPS (localtunnel, ngrok) — voir README.
# Si la variable est absente, le site retombe sur https://dulce-store.com.
NEXT_PUBLIC_SITE_URL="https://dulce-store.com"

# Mot de passe d'accès à /admin (liste des commandes). À définir avant la mise en ligne.
ADMIN_PASSWORD=
